{
  "name": "@caveman-ai/agent",
  "version": "0.2.0",
  "description": "Profile-guided compiler and build system for portable, eval-gated production agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuliusBrussee/agent-sdk.git",
    "directory": "packages/agent"
  },
  "homepage": "https://caveman.so/products/caveman-agent",
  "bugs": {
    "url": "https://github.com/JuliusBrussee/agent-sdk/issues"
  },
  "type": "module",
  "keywords": [
    "agents",
    "ai",
    "compiler",
    "evals",
    "llm",
    "opentelemetry",
    "optimization"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "caveman-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    },
    "./cache-engine": {
      "types": "./dist/cache-planner/index.d.ts",
      "import": "./dist/cache-planner/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "lint": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && tsc && node --test tests/*.runtime.mjs && node --test bench/tests/*.test.mjs && node bench/compiler-replay.mjs --check",
    "test:types": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@pebble-agent/protocol": "file:../pebble-protocol",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.93.0",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@standard-schema/spec": "1.1.0",
    "es-module-lexer": "2.3.1",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mastra/core": "1.55.0",
    "@types/node": "24.10.1",
    "ai": "7.0.43",
    "ajv": "8.20.0",
    "eve": "0.29.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
